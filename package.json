{
	"name": "preact-devtools-overlay-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "pnpm --filter preact-devtools-overlay build",
		"dev": "pnpm build && (pnpm --filter preact-devtools-overlay build --watch & pnpm --filter playground dev)",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter preact-devtools-overlay test",
		"test:e2e": "pnpm --filter playground test:e2e",
		"sync-upstream": "node scripts/sync-upstream.mjs",
		"check-upstream": "node scripts/sync-upstream.mjs --check",
		"update-patches": "node scripts/sync-upstream.mjs --update-patches",
		"test:types": "pnpm --filter preact-devtools-overlay test:types",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3"
	}
}
