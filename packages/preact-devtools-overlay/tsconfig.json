{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@preact/signals-devtools-adapter": [
				"./vendor/signals-devtools/devtools-adapter/src/index.ts"
			]
		}
	},
	"include": ["src", "vendor/preact-devtools/src/global.d.ts", "test"]
}
